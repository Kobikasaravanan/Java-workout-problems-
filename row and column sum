import java.util.*;
public class Main
{
    public static void main(String[]args)
    {
        Scanner sc=new Scanner(System.in);
        int n=sc.nextInt();
        int m=sc.nextInt();
        int mat[][]=new int[n][m];
        for(int i=0;i<n;i++)
        {
            for(int j=0;j<m;j++)
            {
                mat[i][j]=sc.nextInt();
            }
        }
        for(int i=0;i<n;i++)
        {
            int rowsum=0;
            for(int j=0;j<m;j++)
            {
                rowsum=rowsum+mat[i][j];
            }
            System.out.println("Sum of the row "+i+"= "+rowsum);
        }
        for(int j=0;j<m;j++)
        {
            int colsum=0;
            for(int i=0;i<n;i++)
            {
                colsum=colsum+mat[i][j];
            }
            System.out.println("Sum of the column "+j+"= "+colsum);
        }
        System.out.println(" ");
    }
}
