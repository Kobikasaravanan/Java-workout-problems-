import java.util.*;
public class Main
{
    public static void main(String[]args)
    {
        Scanner sc=new Scanner(System.in);
        int n=sc.nextInt();
        int arr[]=new int[n];
        for(int i=0;i<n;i++)
        {
            arr[i]=sc.nextInt();
        }
        for(int i=0;i<n;i++)
        {
            if(arr[i]%3==0&&arr[i]%5==0)
            {
                System.out.print("FizzBuzz");
            }
            else if(arr[i]%3==0)
            {
                System.out.print("Fizz");
            }
            else if(arr[i]%5==0)
            {
                System.out.print("Buzz");
            }
            else
            {
                System.out.print(arr[i]);
            }
            if(i<n-1)
            {
                System.out.print(" ");
            }
        }
    }
} 
