import java.util.*;
public class Main
{
    public static void main(String[]args)
    {
        Scanner sc=new Scanner(System.in);
        int n=sc.nextInt();
        int arr[]=new int[n];
        for(int i=0;i<n;i++)
        {
            arr[i]=sc.nextInt();
        }
        int last =arr[n-1];
        for(int i=n-1;i>0;i--)
        {
            arr[i]=arr[i-1];
        }
        arr[0]=last;
        System.out.print("Rotated Array: ");
        for(int i=0;i<n;i++)
        {
            System.out.print(arr[i]);
            {
                if(i<n-1)
                {
                    System.out.print(" ");
                }
            }
        }
    }
}
