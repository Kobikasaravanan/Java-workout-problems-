import java.util.*;
public class Main
{
    public static void main(String[]args)
    {
        Scanner sc=new Scanner(System.in);
        int row=sc.nextInt();
        int col=sc.nextInt();
        if(row!=col)
        {
            return;
        }
        int[][]mat=new int[row][col];
        int sum=0;
        for(int i=0;i<row;i++)
        {
            for(int j=0;j<col;j++)
            {
                mat[i][j]=sc.nextInt();
                if(i==j)
                {
                    sum=sum+mat[i][j];
                }
            }
        }
        System.out.print(sum);
        
    }
}
