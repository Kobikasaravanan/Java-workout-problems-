import java.util.Scanner;
public class Main {
    public static void main(String[]args)
    {
        Scanner sc=new Scanner(System.in);
        String str=sc.nextLine();
        int length=0;
        int i=str.length()-1;
        while(i>=0 && str.charAt(i)==' ')
        {
            i--;
        }
        while(i>=0 && str.charAt(i)!=' ')
        {
            length++;
            i--;
        }
        System.out.println(length);
    }
}
