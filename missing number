import java.util.*;
public class Main
{
    public static void main(String[]args)
    {
        Scanner sc=new Scanner(System.in);
        int n=sc.nextInt();
        int arr[]=new int[n];
        int sum=0;
        for(int i=0;i<n;i++)
        {
            sum=sum+sc.nextInt();
        }
        int expectedsum=(n+1)*(n+2)/2;
        int missingnumber=expectedsum-sum;
        System.out.println(missingnumber);
    }
}
